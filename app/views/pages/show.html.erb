<div data-controller="avatar image-exporter" class="grid place-items-center mt-12">
  <div class="grid grid-cols-[300px_1fr] gap-8 max-w-5xl">
    <div>
      <svg data-avatar-target="preview" viewBox="0 0 300 300" width="300" height="300" xmlns="http://www.w3.org/2000/svg" class="bg-white border border-gray-200 rounded-lg"></svg>

      <div class="grid grid-cols-2 mt-2 gap-x-3 *:w-full *:bg-gray-300 *:rounded-md">
        <button data-action="click->avatar#reset">
          Reset
        </button>

        <button data-action="click->image-exporter#download">
          Save as image
        </button>
      </div>
    </div>

    <div data-avatar-target="controls" class="grid gap-4"></div>
  </div>
</div>
